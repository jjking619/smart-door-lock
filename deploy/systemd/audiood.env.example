# /etc/doorlock/audiood.env —— 权限 600，切勿提交到 git

# ---- Coze 实时语音（去 https://www.coze.cn/open/oauth/pats 生成）----
COZE_API_TOKEN=pat_这里填你自己的
COZE_MODE=streaming
# 智能体 URL 末尾的数字 ID
COZE_BOT_ID=7466xxxxxxxxxxxxxxxx
COZE_VOICE_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_PROLOGUE=您好，请问有什么事？
COZE_VAD_SILENCE_MS=500
COZE_SESSION_IDLE_S=15
COZE_SESSION_MAX_S=120

# ---- 超时（毫秒级体验的关键）----
COZE_TIMEOUT_S=6
COZE_ASR_TIMEOUT_S=10
COZE_TTS_TIMEOUT_S=8
# 命中 4028（额度不足）后，多久再放行一次 Coze 重试
COZE_QUOTA_RETRY_S=60

# ---- 音频设备（python -m sounddevice 查看编号）----
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# half：播放时屏蔽麦克风（无硬件 AEC 时必须）；full：可插话（需带 AEC 的会议麦）
AUDIO_DUPLEX=half
AUDIO_ECHO_TAIL_MS=400

# ---- 事件 ----
MQTT_HOST=127.0.0.1
MQTT_TOPIC=lock/event

# ---- 日志 ----
LOG_LEVEL=INFO
AUDIO_LOG_DIR=data/logs
AUDIO_LOG_FILE=audiood.log
AUDIO_LOG_MAX_MB=10
AUDIO_LOG_BACKUP_COUNT=5
AUDIO_LOG_CONSOLE=1

# ---- 会话级日志（单次对话独立文件）----
AUDIO_SESSION_LOG_ENABLED=1
AUDIO_SESSION_LOG_DIR=data/logs/sessions
# date: data/logs/sessions/YYYY-MM-DD/session-<sid>.log
# flat: data/logs/sessions/session-<sid>.log
AUDIO_SESSION_LOG_LAYOUT=date
AUDIO_SESSION_LOG_FILE_TEMPLATE=session-{sid}.log
AUDIO_SESSION_LOG_LEVEL=INFO

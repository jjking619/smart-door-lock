# /etc/doorlock/audiood.env —— 权限 600，切勿提交到 git

# ---- Coze（去 https://www.coze.cn/open/oauth/pats 生成）----
COZE_API_TOKEN=pat_这里填你自己的
COZE_WORKFLOW_ID=7466xxxxxxxxxxxxxxxx
COZE_VOICE_ID=
COZE_BASE_URL=https://api.coze.cn

# ---- 超时（毫秒级体验的关键）----
COZE_TIMEOUT_S=6
COZE_ASR_TIMEOUT_S=10
COZE_TTS_TIMEOUT_S=8

# ---- 音频设备（python -m sounddevice 查看编号）----
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SILENCE_RMS=300
AUDIO_MAX_UTTER_S=8

# ---- 事件 ----
MQTT_HOST=127.0.0.1
MQTT_TOPIC=lock/event

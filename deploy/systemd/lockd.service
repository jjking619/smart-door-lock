[Unit]
Description=lockd - unlock decision and lock hardware driver
After=network.target visiond.service
Wants=visiond.service

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_ROOT@
EnvironmentFile=@PROJECT_ROOT@/deploy/systemd/doorlock.env
ExecStart=@PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/main.py --lock-only
Restart=always
RestartSec=3
ReadWritePaths=@PROJECT_ROOT@/data

[Install]
WantedBy=multi-user.target

[Unit]
Description=audiood - doorbell talk / auto reply (Coze)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart-door-lock
EnvironmentFile=-/etc/doorlock/audiood.env
ExecStart=/home/pi/smart-door-lock/.venv/bin/python /home/pi/smart-door-lock/main.py --audio-only
Restart=always
RestartSec=3

SupplementaryGroups=audio
CPUQuota=200%
MemoryMax=512M

[Install]
WantedBy=multi-user.target

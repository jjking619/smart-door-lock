# 四个 systemd 服务共用 deploy/systemd/doorlock.env，权限 600，切勿提交到 git。
# 安装时仅在配置不存在时复制本模板；填写密钥后重启受影响的服务。

# ---- 视觉：采集与双模型 ----
VISION_SOURCE=auto
VISION_HTTP_PORT=8083
VISION_TOKEN=
VISION_WIDTH=1280
VISION_HEIGHT=720
VISION_FPS=10
VISION_RING_SECONDS=10
VISION_MODEL=models/yolov5s-rk3576.rknn
VISION_PACKAGE_MODEL=models/parcel-yolov5n-rk3576-fp.rknn
VISION_PACKAGE_MODEL_CLASS_NAMES=defect-parcel,good-parcel
VISION_PACKAGE_CLASSES=defect-parcel,good-parcel
VISION_CONF=0.35
VISION_PACKAGE_CONF=0.35
VISION_PACKAGE_PERSON_CONF=0.2
VISION_PACKAGE_TILES=1
VISION_INFER_EVERY_N=3

# 归一化坐标，在预览中对照实际画面调整。
VISION_DOORSTEP_POLY="0,0;1,0;1,1;0,1"
VISION_GROUND_POLY="0,0;1,0;1,1;0,1"
VISION_DWELL_S=10
VISION_STATIC_S=5
VISION_PERSON_LEAVE_S=20
VISION_DEDUPE_S=10
VISION_PACKAGE_MAX_AREA=0.3
VISION_PACKAGE_PERSON_OVERLAP=0.5
VISION_CLIP_AFTER_S=20
VISION_DATA_DIR=data
# 1: 无界面、预览或录像时释放相机；0: 持续检测。
VISION_PAUSE_WITHOUT_UI=1
VISION_UI_LEASE_S=15

# ---- 指纹 ----
# 多设备时固定稳定串口路径；未指定则自动扫描。
# FINGERPRINT_SERIAL=/dev/serial/by-id/usb-...
FINGERPRINT_BAUDRATE=57600
FINGERPRINT_HTTP_PORT=8085
FINGERPRINT_DATA_DIR=data

# ---- 锁体：默认 Pin33 SG90；无硬件时改为 mock ----
LOCK_HTTP_PORT=8086
LOCK_DRIVER=servo
LOCK_SERVO_LOCKED_ANGLE=0
LOCK_SERVO_UNLOCKED_ANGLE=90
LOCK_SERVO_MIN_US=500
LOCK_SERVO_MAX_US=2500
LOCK_SERVO_MOVE_S=0.5
LOCK_PULSE_S=5
LOCK_REQUIRE_REGISTERED=1
LOCK_MIN_SCORE=60
LOCK_REPEAT_GUARD_S=5
LOCK_MAX_FAILURES=5
LOCK_LOCKOUT_S=60
# 默认根据 VISION_HTTP_PORT 生成快照地址，通常无需设置。
# LOCK_SNAPSHOT_URL=http://127.0.0.1:8083/snapshot.jpg

# 可选 gpio / mcu 驱动，使用时取消注释并调整。
# LOCK_GPIO_CHIP=gpiochip0
# LOCK_GPIO_LINE=0
# LOCK_GPIO_ACTIVE_LOW=0
# LOCK_MCU_PORT=/dev/serial/by-id/usb-Espressif_...
# DOORLOCK_MCU_KEY=换成32字节以上的随机串

# ---- Coze 实时语音（去 https://www.coze.cn/open/oauth/pats 生成）----
AUDIO_HTTP_PORT=8084
COZE_API_TOKEN=pat_这里填你自己的
COZE_MODE=streaming
# 智能体 URL 末尾的数字 ID
COZE_BOT_ID=7466xxxxxxxxxxxxxxxx
COZE_VOICE_ID=
COZE_BASE_URL=https://api.coze.cn
COZE_PROLOGUE="Hello, how can I help?"
COZE_VAD_SILENCE_MS=500
COZE_SESSION_IDLE_S=15
COZE_SESSION_MAX_S=120

# ---- 超时（单位：秒）----
COZE_TIMEOUT_S=6
COZE_BOT_TIMEOUT_S=15
COZE_ASR_TIMEOUT_S=10
COZE_TTS_TIMEOUT_S=8
# 命中 4028（额度不足）后，多久再放行一次 Coze 重试
COZE_QUOTA_RETRY_S=60

# ---- 音频设备（python -m sounddevice 查看编号）----
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# half：播放时屏蔽麦克风（无硬件 AEC 时必须）；full：可插话（需带 AEC 的会议麦）
AUDIO_DUPLEX=half
AUDIO_ECHO_TAIL_MS=400

# ---- 视觉事件：留空仅本地落盘，配置 broker 后启用 MQTT ----
MQTT_HOST=
MQTT_PORT=1883
MQTT_TOPIC=lock/event

# ---- 日志 ----
LOG_LEVEL=INFO
AUDIO_LOG_DIR=data/logs
AUDIO_LOG_FILE=audiood.log
AUDIO_LOG_MAX_MB=10
AUDIO_LOG_BACKUP_COUNT=5
AUDIO_LOG_CONSOLE=1

# ---- 会话级日志（单次对话独立文件）----
AUDIO_SESSION_LOG_ENABLED=1
AUDIO_SESSION_LOG_DIR=data/logs/sessions
# date: data/logs/sessions/YYYY-MM-DD/session-<sid>.log
# flat: data/logs/sessions/session-<sid>.log
AUDIO_SESSION_LOG_LAYOUT=date
AUDIO_SESSION_LOG_FILE_TEMPLATE=session-{sid}.log
AUDIO_SESSION_LOG_LEVEL=INFO

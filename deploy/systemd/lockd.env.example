# lockd：开锁决策与锁体驱动
# 默认驱动 Pin33 上的 SG90 舵机；没有锁体硬件时改为 LOCK_DRIVER=mock 联调。
LOCK_HTTP_PORT=8086

# mock / gpio / mcu / servo
LOCK_DRIVER=servo

# --- servo 驱动（M2 物理 Pin33，SG90）---
# 50Hz 硬件 PWM。
# 按控制器地址 2ade3000.pwm 自动查找，不依赖 pwmchip 编号。
LOCK_SERVO_LOCKED_ANGLE=0
LOCK_SERVO_UNLOCKED_ANGLE=90
LOCK_SERVO_MIN_US=500
LOCK_SERVO_MAX_US=2500
LOCK_SERVO_MOVE_S=0.5

# --- gpio 驱动（方案 A：Pi 直驱继电器）---
# 用 gpioinfo -c gpiochipN 找到空闲线路号后填这里
LOCK_GPIO_CHIP=gpiochip0
LOCK_GPIO_LINE=0
# 继电器低电平触发时设为 1
LOCK_GPIO_ACTIVE_LOW=0

# --- mcu 驱动（方案 B：ESP32-S3 执行单元）---
# LOCK_MCU_PORT=/dev/serial/by-id/usb-Espressif_...
# DOORLOCK_MCU_KEY=换成 32 字节以上的随机串

# 单次开锁时长（秒）。电磁锁 3-5，电机锁 0.3
LOCK_PULSE_S=5

# 策略
LOCK_REQUIRE_REGISTERED=1
LOCK_MIN_SCORE=60
LOCK_REPEAT_GUARD_S=5
LOCK_MAX_FAILURES=5
LOCK_LOCKOUT_S=60

# 开锁时向前端摄像头要一张存证快照
LOCK_SNAPSHOT_URL=http://127.0.0.1:8083/snapshot.jpg

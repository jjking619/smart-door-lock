# /etc/doorlock/visiond.env  —— 复制后按现场修改，权限 600

# ---- 采集 ----
VISION_SOURCE=0
VISION_WIDTH=1280
VISION_HEIGHT=720
VISION_FPS=10
VISION_RING_SECONDS=10

# ---- 模型 ----
VISION_MODEL=models/yolo11n.rknn
VISION_CONF=0.35
VISION_INFER_EVERY_N=3

# ---- ROI（归一化坐标，务必在 /stream 里对着实际画面调）----
VISION_DOORSTEP_POLY=0.05,0.10;0.95,0.10;0.95,0.95;0.05,0.95
VISION_GROUND_POLY=0.05,0.55;0.95,0.55;0.95,0.98;0.05,0.98

# ---- 规则 ----
VISION_DWELL_S=10
VISION_STATIC_S=10
VISION_PERSON_LEAVE_S=20
VISION_DEDUPE_S=300

# ---- 录像 ----
VISION_CLIP_AFTER_S=20
VISION_DATA_DIR=/home/pi/smart-door-lock/data

# ---- HTTP（公网必须设置 TOKEN）----
VISION_HTTP_PORT=8081
VISION_TOKEN=

# ---- 事件总线 ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=lock/event

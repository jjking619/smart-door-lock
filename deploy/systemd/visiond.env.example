# /etc/doorlock/visiond.env  —— 复制后按现场修改，权限 600

# ---- 采集 ----
# auto: 每次打开/重连时扫描 /dev/v4l/by-id/*-video-index0，不依赖 /dev/videoN 编号。
# 多个摄像头时可固定为 /dev/v4l/by-id/usb-...-video-index0；不要写 /dev/video73 这类会变的编号。
VISION_SOURCE=auto
VISION_WIDTH=1280
VISION_HEIGHT=720
VISION_FPS=10
VISION_RING_SECONDS=10

# ---- 模型 ----
VISION_MODEL=models/yolov5s-rk3576.rknn
VISION_PACKAGE_MODEL=models/parcel-yolov5n-rk3576-fp.rknn
VISION_PACKAGE_MODEL_CLASS_NAMES=defect-parcel,good-parcel
VISION_PACKAGE_CLASSES=defect-parcel,good-parcel
VISION_CONF=0.35
VISION_INFER_EVERY_N=3

# ---- ROI（归一化坐标，务必在 /stream 里对着实际画面调）----
VISION_DOORSTEP_POLY=0,0;1,0;1,1;0,1
VISION_GROUND_POLY=0,0;1,0;1,1;0,1

# ---- 规则 ----
VISION_DWELL_S=10
VISION_STATIC_S=5
VISION_PERSON_LEAVE_S=20
VISION_DEDUPE_S=10
# 包裹误检过滤：过大框、落在人身上的框丢弃（包裹模型会把人脸/躯干认成包裹）
VISION_PACKAGE_MAX_AREA=0.3
VISION_PACKAGE_PERSON_OVERLAP=0.5

# ---- 录像 ----
VISION_CLIP_AFTER_S=20
VISION_DATA_DIR=/home/pi/smart-door-lock/data

# ---- 无界面暂停 ----
# 1: 界面关闭（心跳超时）且无预览/录像时释放相机、暂停检测——入侵/快递告警随之停止
# 0: 7×24 持续检测
VISION_PAUSE_WITHOUT_UI=1
VISION_UI_LEASE_S=15

# ---- HTTP（公网必须设置 TOKEN）----
VISION_HTTP_PORT=8081
VISION_TOKEN=

# ---- 事件总线 ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=lock/event
